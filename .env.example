# Copy to .env and set real values. .env is git-ignored; this file holds names only.

# PostGIS (service name "db" inside Compose; other containers reach it as host "db")
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host port mapped to the container's 5432 (5432 and 5433 are already used on this laptop)
POSTGRES_PORT=5434

# GeoServer admin login and host port
GEOSERVER_ADMIN_USER=
GEOSERVER_ADMIN_PASSWORD=
GEOSERVER_PORT=8080

# pg_tileserv and pg_featureserv host ports
TILESERV_PORT=7800
FEATURESERV_PORT=9000

# bonus isochrone API (FastAPI + pgRouting) host port
API_PORT=8000
